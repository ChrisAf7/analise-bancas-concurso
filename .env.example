# Copie para .env e preencha. O .env NUNCA vai para o git (repositório público).
# Passo a passo: docs/SETUP_IA.md

# Avaliador A — Google AI Studio (plano gratuito, sem cartão)
GEMINI_API_KEY=

# Avaliador B — OpenRouter (usar só modelos com sufixo :free)
OPENROUTER_API_KEY=

# Avaliador C (opcional) — Ollama local; normalmente http://localhost:11434/v1
OLLAMA_BASE_URL=
